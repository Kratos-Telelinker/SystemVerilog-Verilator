# Dual-mode Makefile: DEBUG=1 for debug, FAST=1 for optimized

UNAME_S := $(shell uname -s)

ifeq ($(UNAME_S),Linux)
    PLATFORM = linux
    VERILATOR = verilator
    BASE_FLAGS = -Wall --Wno-fatal --top-module tinyalu
else
    PLATFORM = windows
    VERILATOR = verilator
    BASE_FLAGS = -Wall --Wno-fatal --top-module tinyalu \
        -I/mingw64/share/verilator/include
endif

RTL_DIR := ../rtl
OBJ_DIR := obj_dir
TOP     := tinyalu

RTL_SRCS := \
    $(RTL_DIR)/tinyalu_op_t.sv \
    $(RTL_DIR)/tinyalu.sv \
    $(RTL_DIR)/single_cycle.sv \
    $(RTL_DIR)/three_cycle.sv

TB  := sim_main.cpp
EXE := $(OBJ_DIR)/V$(TOP)

# Mode selection
DEBUG ?= 0
FAST  ?= 1

ifeq ($(DEBUG),1)
    VERILATOR_FLAGS := $(BASE_FLAGS) --trace --coverage --coverage-line
    BUILD_OPTS      := OPT_FAST=0
else
    VERILATOR_FLAGS := $(BASE_FLAGS)
    BUILD_OPTS      := OPT_FAST=1
endif

all: clean build run

clean:
    @echo "=== Cleaning old build ==="
    rm -rf $(OBJ_DIR) cov_annotate coverage.info coverage_report.html

build:
    @echo "=== Building on $(PLATFORM) (DEBUG=$(DEBUG), FAST=$(FAST)) ==="
    $(VERILATOR) $(VERILATOR_FLAGS) --cc $(RTL_SRCS) \
        --exe $(TB) \
        --Mdir $(OBJ_DIR)
    make -C $(OBJ_DIR) -f V$(TOP).mk $(BUILD_OPTS)

run:
    @echo "=== Running TinyALU simulation ==="
    $(EXE)

coverage:
    @echo "=== Generating coverage (requires DEBUG=1 build) ==="
    verilator_coverage --write-info coverage.info $(OBJ_DIR)/coverage.dat
    verilator_coverage --annotate cov_annotate $(OBJ_DIR)/coverage.dat
