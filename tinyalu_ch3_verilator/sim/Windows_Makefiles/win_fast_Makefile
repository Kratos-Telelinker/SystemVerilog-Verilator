# Fast Windows Makefile for TinyALU (MSYS2 MinGW64)

UNAME_S := $(shell uname -s)

ifeq ($(UNAME_S),Linux)
    PLATFORM = linux
    VERILATOR = verilator
    VERILATOR_FLAGS = -Wall --Wno-fatal --top-module tinyalu
else
    PLATFORM = windows
    VERILATOR = verilator
    VERILATOR_FLAGS = -Wall --Wno-fatal --top-module tinyalu \
        -I/mingw64/share/verilator/include
endif

RTL_DIR := ../rtl
OBJ_DIR := obj_dir
TOP     := tinyalu

RTL_SRCS := \
    $(RTL_DIR)/tinyalu_op_t.sv \
    $(RTL_DIR)/tinyalu.sv \
    $(RTL_DIR)/single_cycle.sv \
    $(RTL_DIR)/three_cycle.sv

TB  := sim_main.cpp
EXE := $(OBJ_DIR)/V$(TOP)

all: clean build run

clean:
    @echo "=== Cleaning old build ==="
    rm -rf $(OBJ_DIR) cov_annotate coverage.info coverage_report.html

build:
    @echo "=== Fast build on $(PLATFORM) (no trace, no coverage) ==="
    $(VERILATOR) $(VERILATOR_FLAGS) --cc $(RTL_SRCS) \
        --exe $(TB) \
        --Mdir $(OBJ_DIR)
    make -C $(OBJ_DIR) -f V$(TOP).mk OPT_FAST=1

run:
    @echo "=== Running TinyALU simulation ==="
    $(EXE)
